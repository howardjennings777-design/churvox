nav = read(nav_path)
nav = replace_exact(nav, '  ["intelligence", "Intelligence"],\n  ["command", "Command"],', '  ["intelligence", "Intelligence"],\n  ["golive", "Go Live"],\n  ["command", "Command"],', "owner Go Live navigation")
write(nav_path, nav)

access_path = "frontend/src/churvox-office-lab/OfficeTeamAccess.js"
access = read(access_path)
access = replace_exact(access, '  intelligence: "intelligence",\n  command: "command",', '  intelligence: "intelligence",\n  golive: "golive",\n  command: "command",', "Go Live access map")
access = replace_exact(access, '  brain: "intelligence",\n  cockpit: "command",', '  brain: "intelligence",\n  golive: "golive",\n  onboarding: "golive",\n  imports: "golive",\n  portability: "golive",\n  trust: "golive",\n  cockpit: "command",', "Go Live access aliases")
write(access_path, access)

app_path = "frontend/src/App.js"
app = read(app_path)
app = replace_exact(app, '              <Route path="/offline-sync" element={<AppRedirect to="/dashboard#help" />} />\n              <Route path="/onboarding" element={<AppRedirect to="/dashboard#help" />} />', '              <Route path="/offline-sync" element={<AppRedirect to="/dashboard#golive" />} />\n              <Route path="/onboarding" element={<AppRedirect to="/dashboard#golive" />} />\n              <Route path="/imports" element={<AppRedirect to="/dashboard#golive" />} />\n              <Route path="/portability" element={<AppRedirect to="/dashboard#golive" />} />', "Go Live redirects")
write(app_path, app)

# Clean and strengthen the plan contract without changing prices.
plans_path = "frontend/src/churvox-fresh/planRules.js"
plans = read(plans_path)
