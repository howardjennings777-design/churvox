from pathlib import Path
import json
import re
import shutil

ROOT = Path(__file__).resolve().parents[1]


def read(path):
    return (ROOT / path).read_text(encoding="utf-8")


def write(path, content):
    target = ROOT / path
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(content, encoding="utf-8")


def replace_exact(source, old, new, label, count=1):
    actual = source.count(old)
    if actual != count:
        raise RuntimeError(f"{label}: expected {count} exact match(es), found {actual}")
    return source.replace(old, new)


def replace_regex(source, pattern, replacement, label, count=1, flags=re.S):
    result, actual = re.subn(pattern, replacement, source, count=count, flags=flags)
    if actual != count:
        raise RuntimeError(f"{label}: expected {count} regex match(es), found {actual}")
    return result


# Assemble newly staged product files.
shutil.copyfile(ROOT / ".churvox-tmp/launch-api.part", ROOT / "frontend/src/churvox-office-lab/OfficeTeamLaunchHardeningApi.js")
shutil.copyfile(ROOT / ".churvox-tmp/worker-offline-queue.part", ROOT / "frontend/src/churvox-office-lab/workerOfflineQueue.js")
shutil.copyfile(ROOT / ".churvox-tmp/launch-style.part", ROOT / "frontend/src/churvox-office-lab/OfficeTeamLaunchHardening.css")
ui = read(".churvox-tmp/launch-ui-00.part") + read(".churvox-tmp/launch-ui-01.part") + r'''
}

function OfflineFeature({ feature, go }) {
  return <section className="cvLaunchPanel"><PanelHeader eyebrow="Offline Worker Sync" title={feature?.available ? "Field work can wait safely for reception" : "Offline worker tools begin at Crew"} text="Assigned jobs are saved to the device. Status, notes, proof and completion use an idempotent queue with visible Saved offline, Waiting to sync, Synced and Needs attention states." /><div className="cvLaunchOfflineFlow"><article><strong>1</strong><h3>Saved on this device</h3><p>The worker sees the last confirmed assigned jobs and can keep working without reception.</p></article><article><strong>2</strong><h3>Queued once</h3><p>Every event has a permanent idempotency key, so reconnecting cannot duplicate completion or proof.</p></article><article><strong>3</strong><h3>Server rechecks</h3><p>Assignment and Proof Coach requirements are checked again before an offline event is applied.</p></article><article><strong>4</strong><h3>Visible result</h3><p>Applied events disappear from the queue. Conflicts remain as Needs attention instead of being silently lost.</p></article></div><button className="cvLaunchOpenWorker" type="button" disabled={!feature?.available} onClick={() => go?.("worker")}>{feature?.available ? "Open worker controls" : "Crew unlocks worker access"}</button></section>;
}
'''
write("frontend/src/churvox-office-lab/OfficeTeamLaunchHardening.jsx", ui)

# Owner routing, navigation and access.
lab_path = "frontend/src/churvox-office-lab/OfficeTeamLabSite.jsx"
lab = read(lab_path)
lab = replace_exact(lab, 'import OfficeTeamIntelligence from "./OfficeTeamIntelligence";\n', 'import OfficeTeamIntelligence from "./OfficeTeamIntelligence";\nimport OfficeTeamLaunchHardening from "./OfficeTeamLaunchHardening";\n', "Go Live import")
lab = replace_exact(lab, '["today", "Today"], ["intelligence", "Intelligence"], ["command", "Command"]', '["today", "Today"], ["intelligence", "Intelligence"], ["golive", "Go Live"], ["command", "Command"]', "lab screen list")
lab = replace_exact(lab, '"smart-hub": "today", intelligence: "intelligence", insights: "intelligence", brain: "intelligence",', '"smart-hub": "today", intelligence: "intelligence", insights: "intelligence", brain: "intelligence", golive: "golive", onboarding: "golive", imports: "golive", portability: "golive", trust: "golive",', "lab aliases")
lab = replace_exact(lab, '  if (screen === "intelligence") return <OfficeTeamIntelligence appMode={appMode} go={props.go} />;\n  if (screen === "command")', '  if (screen === "intelligence") return <OfficeTeamIntelligence appMode={appMode} go={props.go} />;\n  if (screen === "golive") return <OfficeTeamLaunchHardening appMode={appMode} go={props.go} />;\n  if (screen === "command")', "Go Live screen route")
write(lab_path, lab)

nav_path = "frontend/src/churvox-office-lab/OfficeTeamOwnerNavigation.jsx"
