};'''
plans = replace_regex(plans, r'export const FEATURE_RULES = \{.*?\n\};', feature_rules, "feature rules")
plan_matrix = '''export const PLAN_FEATURE_MATRIX = [
  { area: "Jobs, repeat work, clients, quotes, invoices", start: "Included", crew: "Included", operator: "Included", command: "Included" },
  { area: "Settings, plans, help and Go Live", start: "Included", crew: "Included", operator: "Included", command: "Included" },
  { area: "Imports, recovery, portability and evidence", start: "Included", crew: "Included", operator: "Included", command: "Included" },
  { area: "Customer portal basics", start: "Included", crew: "Included", operator: "Included", command: "Included" },
  { area: "Money Left Behind, Job Truth Receipt, Promise Memory and Voice-to-Business", start: "Included", crew: "Included", operator: "Included", command: "Included" },
  { area: "Worker View, Offline Worker Sync and Worker Proof Coach", start: "Locked", crew: "Included", operator: "Included", command: "Included" },
  { area: "Safe role presets", start: "Owner only", crew: "Included", operator: "Included", command: "Included" },
