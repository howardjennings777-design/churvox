  { area: "AI prepared admin", start: "Locked", crew: "Locked", operator: "Included", command: "Included" },
  { area: "Command Approval System", start: "Locked", crew: "Locked", operator: "Included", command: "Full" },
  { area: "Xero sync", start: "$39 add-on", crew: "$39 add-on", operator: "$39 add-on", command: "Included" },
  { area: "Command Growth Pack", start: "Locked", crew: "Locked", operator: "Locked", command: "Available" },
];'''
plans = replace_regex(plans, r'export const PLAN_FEATURE_MATRIX = \[.*?\n\];', plan_matrix, "plan matrix")
write(plans_path, plans)

# Worker offline queue, proof gating and visible sync state.
worker_path = "frontend/src/churvox-office-lab/OfficeTeamWorkerRoute.jsx"
worker = read(worker_path)
worker = replace_exact(worker, 'import React, { useMemo, useState } from "react";', 'import React, { useEffect, useMemo, useState } from "react";', "worker React import")
worker = replace_exact(worker, 'import { useApi } from "../hooks/useApi";\n', '', "remove direct worker API hook")
worker = replace_exact(worker, 'import { checkWorkerProofCoach, fetchWorkerProofCoach } from "./OfficeTeamIntelligenceApi";', 'import { fetchWorkerProofCoach } from "./OfficeTeamIntelligenceApi";\nimport { syncWorkerEvents } from "./OfficeTeamLaunchHardeningApi";\nimport { cacheWorkerJobs, filesForOffline, flushWorkerEvents, listWorkerEvents, queueWorkerEvent, readCachedWorkerJobs, subscribeWorkerSync, workerNetworkState } from "./workerOfflineQueue";', "worker offline imports")
worker = replace_exact(worker, '  const { post } = useApi();\n', '', "remove worker post hook")
worker = replace_exact(worker, '  const [showAllJobs, setShowAllJobs] = useState(false);', '  const [showAllJobs, setShowAllJobs] = useState(false);\n  const [cachedRows, setCachedRows] = useState([]);\n  const [network, setNetwork] = useState(() => workerNetworkState());\n  const [syncItems, setSyncItems] = useState([]);\n  const [syncBusy, setSyncBusy] = useState(false);\n  const [syncState, setSyncState] = useState("Synced");', "worker sync state")
worker = replace_exact(worker, '  const rows = live.rows;', '  const liveRows = Array.isArray(live.rows) ? live.rows : [];\n  const rows = liveRows.length ? liveRows : cachedRows;', "worker cached rows")
proof_effect = '''  useEffect(() => {
    if (!liveRows.length) return;
    setCachedRows(liveRows);
    cacheWorkerJobs(liveRows).catch(() => {});
  }, [liveRows]);

  useEffect(() => {
    let active = true;
    Promise.all([readCachedWorkerJobs(), listWorkerEvents()]).then(([snapshot, events]) => {
      if (!active) return;
      setCachedRows((current) => current.length ? current : (Array.isArray(snapshot?.rows) ? snapshot.rows : []));
      setSyncItems(events);
      setSyncState(events.some((item) => ["needs_attention", "denied"].includes(item.status)) ? "Needs attention" : events.length ? workerNetworkState().online ? "Waiting to sync" : "Saved offline" : "Synced");
    }).catch(() => {});
    const unsubscribe = subscribeWorkerSync((state) => {
      if (!active) return;
      setNetwork({ online: state.online });
      refreshSyncState();
      if (state.online) flushQueue();
    });
    return () => { active = false; unsubscribe(); };
  }, []); // eslint-disable-line react-hooks/exhaustive-deps

